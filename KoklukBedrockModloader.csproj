<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <AssemblyName>BedrockLoader</AssemblyName>
    <RootNamespace>BedrockLoader</RootNamespace>
    <Version>0.18.1</Version>
    <ApplicationIcon>Assets\BedrockLoader.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FluentVariant)' == 'true'">
    <DefineConstants>$(DefineConstants);FLUENT_VARIANT</DefineConstants>
    <AssemblyName>BedrockLoader.Fluent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;tools/**/*.cs;installer-payload*/**;installer-test*/**" />
    <InternalsVisibleTo Include="DiscordPresence.Tests" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <EmbeddedResource Include="$(CurseForgeKeyFile)" LogicalName="BedrockLoader.CurseForgeKey" Condition="'$(CurseForgeKeyFile)' != ''" />
    <Content Include="Assets\BedrockLoaderPresence.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="RELEASE-NOTES.md" LogicalName="BedrockLoader.ReleaseNotes.md" />
    <EmbeddedResource Include="Assets\WolfTransparent.png" LogicalName="BedrockLoader.WolfTransparent.png" />
  </ItemGroup>
</Project>
